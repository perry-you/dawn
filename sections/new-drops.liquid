{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .new-drops-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .new-drops-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .new-drops-{{ section.id }} .nd-title {
    font-size: 2.4rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0 0 2.4rem;
    font-weight: 600;
    text-align: {{ section.settings.heading_alignment }};
  }
  @media screen and (max-width: 599px) {
    .new-drops-{{ section.id }} .nd-title {
      font-size: 1.8rem;
      margin-bottom: 1.6rem;
    }
  }

  .nd-container-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .nd-container-{{ section.id }} {
      grid-template-columns: 6fr 4fr;
      gap: 2rem;
      align-items: start;
    }
  }

  /* 左侧 master 区 */
  .nd-master-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .nd-main-image-{{ section.id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .nd-main-image-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }
  .nd-info-row-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
    align-items: stretch;
  }
  .nd-sub-image-{{ section.id }} {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .nd-sub-image-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .nd-info-{{ section.id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.8rem;
    color: {{ section.settings.text_color }};
    padding: 0.5rem 0;
  }
  .nd-info-{{ section.id }} h3 {
    font-size: 1.6rem;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-weight: 500;
    line-height: 1.3;
  }
  @media screen and (max-width: 599px) {
    .nd-info-{{ section.id }} h3 {
      font-size: 1.4rem;
    }
  }
  .nd-info-{{ section.id }} .nd-price {
    font-size: 1.4rem;
    color: {{ section.settings.text_color }};
  }
  .nd-info-{{ section.id }} .nd-link {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 0.3em;
    font-size: 1.3rem;
    display: inline-block;
    margin-top: 0.4rem;
  }
  .nd-info-{{ section.id }} .nd-link:hover {
    opacity: 0.7;
  }

  /* 右侧 2x3 缩略图网格 */
  .nd-list-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 0.8rem;
  }
  .nd-thumb-{{ section.id }} {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    position: relative;
    display: block;
  }
  .nd-thumb-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }
  .nd-thumb-{{ section.id }}:hover img {
    opacity: 0.75;
  }
  .nd-thumb-{{ section.id }}[aria-current="true"] img {
    opacity: 0.55;
  }
  .nd-thumb-{{ section.id }}[aria-current="true"]::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid {{ section.settings.text_color }};
    box-sizing: border-box;
    pointer-events: none;
  }
  .nd-thumb-{{ section.id }}:focus-visible {
    outline: 2px solid {{ section.settings.text_color }};
    outline-offset: 2px;
  }

  .nd-view-all-{{ section.id }} {
    text-align: center;
    margin-top: 2.4rem;
  }
  .nd-view-all-{{ section.id }} a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 0.3em;
    font-size: 1.4rem;
  }
{%- endstyle -%}

<div class="new-drops-{{ section.id }} isolate">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="nd-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="nd-container-{{ section.id }}">
      <!-- 左侧 master 区 -->
      <div class="nd-master-{{ section.id }}">
        <div class="nd-main-image-{{ section.id }}">
          <img
            id="nd-main-img-{{ section.id }}"
            src=""
            alt=""
            width="800"
            height="600"
          >
        </div>
        <div class="nd-info-row-{{ section.id }}">
          <div class="nd-sub-image-{{ section.id }}">
            <img
              id="nd-sub-img-{{ section.id }}"
              src=""
              alt=""
              width="300"
              height="300"
            >
          </div>
          <div class="nd-info-{{ section.id }}">
            <h3 id="nd-title-prod-{{ section.id }}"></h3>
            <span class="nd-price" id="nd-price-{{ section.id }}"></span>
            <a class="nd-link" id="nd-link-{{ section.id }}" href="#">View Product →</a>
          </div>
        </div>
      </div>

      <!-- 右侧 6 个缩略图 2x3 网格 -->
      <div class="nd-list-{{ section.id }}" id="nd-list-{{ section.id }}" role="tablist" aria-label="Product selector">
        {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
          {%- for product in section.settings.collection.products limit: 6 -%}
            <button
              type="button"
              class="nd-thumb-{{ section.id }}"
              data-idx="{{ forloop.index0 }}"
              role="tab"
              aria-label="{{ product.title | escape }}"
            >
              {%- if product.featured_media -%}
                <img
                  src="{{ product.featured_media | image_url: width: 300 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'nd-placeholder' }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <button
              type="button"
              class="nd-thumb-{{ section.id }}"
              data-idx="{{ forloop.index0 }}"
              role="tab"
              aria-label="Placeholder product {{ forloop.index }}"
            >
              {{ 'product-apparel-1' | placeholder_svg_tag: 'nd-placeholder' }}
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="nd-view-all-{{ section.id }}">
        <a href="{{ section.settings.collection.url }}">View All →</a>
      </div>
    {%- endif -%}
  </div>
</div>

<script type="application/json" id="nd-data-{{ section.id }}">
[
  {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
    {%- for product in section.settings.collection.products limit: 6 -%}
      {%- capture main_srcset -%}{%- if product.featured_media -%}{%- if product.featured_media.width >= 400 -%}{{ product.featured_media | image_url: width: 400 }} 400w, {%- endif -%}{%- if product.featured_media.width >= 800 -%}{{ product.featured_media | image_url: width: 800 }} 800w, {%- endif -%}{%- if product.featured_media.width >= 1200 -%}{{ product.featured_media | image_url: width: 1200 }} 1200w{%- endif -%}{%- endif -%}{%- endcapture -%}
      {
        "title": {{ product.title | json }},
        "price": {{ product.price | money | json }},
        "url": {{ product.url | json }},
        "mainSrc": {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 800 | json }}{%- else -%}""{%- endif -%},
        "mainSrcset": {{ main_srcset | strip | json }},
        "mainAlt": {{ product.featured_media.alt | default: product.title | json }},
        "subSrc": {%- if product.media[1] -%}{{ product.media[1] | image_url: width: 400 | json }}{%- elsif product.featured_media -%}{{ product.featured_media | image_url: width: 400 | json }}{%- else -%}""{%- endif -%},
        "subAlt": {%- if product.media[1] -%}{{ product.media[1].alt | default: product.title | json }}{%- else -%}{{ product.featured_media.alt | default: product.title | json }}{%- endif -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
]
</script>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var dataEl = document.getElementById('nd-data-' + sectionId);
    var list = document.getElementById('nd-list-' + sectionId);
    var mainImg = document.getElementById('nd-main-img-' + sectionId);
    var subImg = document.getElementById('nd-sub-img-' + sectionId);
    var titleEl = document.getElementById('nd-title-prod-' + sectionId);
    var priceEl = document.getElementById('nd-price-' + sectionId);
    var linkEl = document.getElementById('nd-link-' + sectionId);

    if (!dataEl || !list) return;

    var products = [];
    try {
      products = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
      return;
    }
    if (!products.length) return;

    function selectProduct(idx) {
      var p = products[idx];
      if (!p) return;

      if (p.mainSrc) {
        mainImg.src = p.mainSrc;
        if (p.mainSrcset) {
          mainImg.srcset = p.mainSrcset;
          mainImg.sizes = '(min-width: 750px) 60vw, 100vw';
        } else {
          mainImg.removeAttribute('srcset');
          mainImg.removeAttribute('sizes');
        }
        mainImg.alt = p.mainAlt || '';
      }

      if (p.subSrc) {
        subImg.src = p.subSrc;
        subImg.alt = p.subAlt || '';
      }

      titleEl.textContent = p.title || '';
      priceEl.textContent = p.price || '';
      if (p.url) {
        linkEl.href = p.url;
        linkEl.style.display = '';
      } else {
        linkEl.style.display = 'none';
      }

      list.querySelectorAll('[data-idx]').forEach(function (btn) {
        var isActive = parseInt(btn.getAttribute('data-idx'), 10) === idx;
        if (isActive) {
          btn.setAttribute('aria-current', 'true');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.removeAttribute('aria-current');
          btn.setAttribute('aria-selected', 'false');
        }
      });
    }

    list.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-idx]');
      if (!btn) return;
      selectProduct(parseInt(btn.getAttribute('data-idx'), 10));
    });

    list.addEventListener('keydown', function (e) {
      var btn = e.target.closest('[data-idx]');
      if (!btn) return;
      var idx = parseInt(btn.getAttribute('data-idx'), 10);
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        var next = idx + 1;
        if (next >= products.length) next = 0;
        var nextBtn = list.querySelector('[data-idx="' + next + '"]');
        if (nextBtn) {
          nextBtn.focus();
          selectProduct(next);
        }
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        var prev = idx - 1;
        if (prev < 0) prev = products.length - 1;
        var prevBtn = list.querySelector('[data-idx="' + prev + '"]');
        if (prevBtn) {
          prevBtn.focus();
          selectProduct(prev);
        }
      }
    });

    // 默认选中第一个
    selectProduct(0);
  })();
</script>

{% schema %}
{
  "name": "New Drops",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "NEW DROPS",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "Show 'View all' link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "New Drops",
      "settings": {
        "collection": "bracelets",
        "title": "NEW DROPS",
        "heading_alignment": "left",
        "bg_color": "#1a1a1a",
        "text_color": "#ffffff",
        "show_view_all": false,
        "padding_top": 40,
        "padding_bottom": 40
      }
    }
  ]
}
{% endschema %}
