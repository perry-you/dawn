{% comment %}
  Loved by thousands of Users worldwide - Reviews Carousel Section
  Placement: Homepage, below Bestsellers
  Adapted from consciousitems.com reviews module (Swiper 11, loop, 4/2 slides)
  Brand palette: #b8956a (gold), #2d2a26 (text), #f5f1ea (bg)
{% endcomment %}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

<style>
  .reviews-section {
    background:
      linear-gradient(0deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.3)),
      linear-gradient(0deg, rgba(184, 149, 106, 0.08), rgba(184, 149, 106, 0.08));
    padding: 4rem 0 7rem;
  }

  .reviews-header {
    text-align: center;
  }

  .reviews-title {
    font-size: 3.2rem;
    line-height: 1.2;
    color: rgb(var(--color-foreground));
    margin: 0 0 0.4rem;
  }

  .reviews-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    margin: 1rem 0 1.7rem;
  }

  .reviews-rating .reviews-stars {
    width: 14rem;
    height: auto;
    flex-shrink: 0;
  }

  .reviews-rating-text {
    font-size: 1.6rem;
    color: rgb(var(--color-foreground));
  }

  .reviews-rating-text strong {
    font-weight: 700;
  }

  .reviews-people {
    display: flex;
    flex-shrink: 0;
  }

  .reviews-people svg {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    border: 0.2rem solid #ffffff;
    background: #b8956a;
  }

  .reviews-people svg + svg {
    margin-left: -0.9rem;
  }

  .reviews-people svg:nth-child(2) { background: #a3814f; }
  .reviews-people svg:nth-child(3) { background: #c9ab84; }
  .reviews-people svg:nth-child(4) { background: #97794f; }

  .reviews-carousel-container {
    position: relative;
    margin-top: 3rem;
  }

  .reviews-swiper {
    padding: 4.3rem 13.2rem;
  }

  .review-card {
    background: #ffffff;
    border-radius: 0.6rem;
    box-shadow: 1.2rem 0.9rem 1.8rem 0.9rem rgba(184, 149, 106, 0.25);
    box-sizing: border-box;
    height: auto;
  }

  .review-card-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.5rem 1.5rem 0;
  }

  .review-card-head img {
    max-width: 4.5rem;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: 50%;
  }

  .review-card-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .review-card-head-text svg {
    width: 8rem;
    height: auto;
  }

  .review-card-head-text span {
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 2.5rem;
    text-transform: capitalize;
    color: #2d2a26;
  }

  .review-card-desc {
    padding: 1.5rem;
    font-size: 1.6rem;
    color: #2d2a26;
    line-height: 2.1rem;
    min-height: 6rem;
    margin: 0.1rem 0 0;
  }

  .reviews-carousel-container .swiper-pagination {
    bottom: -3.3rem;
  }

  .reviews-carousel-container .swiper-pagination span.swiper-pagination-bullet {
    background: transparent;
    border: 0.1rem solid #2d2a26;
    opacity: 1;
  }

  .reviews-carousel-container .swiper-pagination span.swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #2d2a26;
  }

  @media screen and (max-width: 989px) {
    .reviews-swiper {
      padding: 4.3rem 6rem;
    }
  }

  @media screen and (max-width: 599px) {
    .reviews-section {
      padding: 4rem 0 8.5rem;
    }

    .reviews-title {
      font-size: 1.8rem;
      line-height: 3.2rem;
      padding: 0 3.4rem;
    }

    .reviews-rating {
      margin: 1rem 0 1.7rem;
      gap: 0.8rem;
    }

    .reviews-swiper.swiper-initialized.swiper-horizontal {
      padding: 6rem 0;
    }

    .review-card-desc {
      min-height: 10.1rem;
    }

  }
</style>

<section class="reviews-section">
  <div class="reviews-header">
    {% if section.settings.heading != blank %}
      <h2 class="reviews-title">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="reviews-rating">
      <svg class="reviews-stars" viewBox="0 0 140 24" fill="#b8956a" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="5 star rating">
        <path d="M12 1.5l3.1 6.9 7.4.7-5.6 5 1.6 7.4L12 17.7l-6.5 3.8 1.6-7.4-5.6-5 7.4-.7z"/>
        <path transform="translate(29 0)" d="M12 1.5l3.1 6.9 7.4.7-5.6 5 1.6 7.4L12 17.7l-6.5 3.8 1.6-7.4-5.6-5 7.4-.7z"/>
        <path transform="translate(58 0)" d="M12 1.5l3.1 6.9 7.4.7-5.6 5 1.6 7.4L12 17.7l-6.5 3.8 1.6-7.4-5.6-5 7.4-.7z"/>
        <path transform="translate(87 0)" d="M12 1.5l3.1 6.9 7.4.7-5.6 5 1.6 7.4L12 17.7l-6.5 3.8 1.6-7.4-5.6-5 7.4-.7z"/>
        <path transform="translate(116 0)" d="M12 1.5l3.1 6.9 7.4.7-5.6 5 1.6 7.4L12 17.7l-6.5 3.8 1.6-7.4-5.6-5 7.4-.7z"/>
      </svg>
      <div class="reviews-rating-text">
        Rated <strong>{{ section.settings.rating_score }}</strong> Based on <strong>{{ section.settings.rating_count }}</strong> happy customers
      </div>

    </div>
  </div>

  <div class="reviews-carousel-container">
    <div class="swiper reviews-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide review-card" {{ block.shopify_attributes }}>
            <div class="review-card-head">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 90 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {% endif %}
              <div class="review-card-head-text">
                <svg viewBox="0 0 80 14" fill="#b8956a" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="5 stars">
                  <path d="M7 0.8l1.9 4.3 4.6.4-3.5 3.1 1 4.6L7 10.8l-4 2.4 1-4.6L.5 5.5l4.6-.4z"/>
                  <path transform="translate(18 0)" d="M7 0.8l1.9 4.3 4.6.4-3.5 3.1 1 4.6L7 10.8l-4 2.4 1-4.6L.5 5.5l4.6-.4z"/>
                  <path transform="translate(36 0)" d="M7 0.8l1.9 4.3 4.6.4-3.5 3.1 1 4.6L7 10.8l-4 2.4 1-4.6L.5 5.5l4.6-.4z"/>
                  <path transform="translate(54 0)" d="M7 0.8l1.9 4.3 4.6.4-3.5 3.1 1 4.6L7 10.8l-4 2.4 1-4.6L.5 5.5l4.6-.4z"/>
                  <path transform="translate(72 0)" d="M7 0.8l1.9 4.3 4.6.4-3.5 3.1 1 4.6L7 10.8l-4 2.4 1-4.6L.5 5.5l4.6-.4z"/>
                </svg>
                {% if block.settings.name != blank %}
                  <span>{{ block.settings.name | escape }}</span>
                {% endif %}
              </div>
            </div>
            {% if block.settings.text != blank %}
              <p class="review-card-desc">{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="swiper-pagination reviews-pagination"></div>
  </div>
</section>

<script>
  window.addEventListener('load', function () {
    if (typeof Swiper === 'undefined') return;
    new Swiper('.reviews-swiper', {
      slidesPerView: 2,
      spaceBetween: 18,
      loop: true,
      pagination: {
        el: '.reviews-pagination.swiper-pagination',
        dynamicBullets: true,
        clickable: true
      },
      breakpoints: {
        0: {
          slidesPerView: 2,
          spaceBetween: 8
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 18,
          initialSlide: 1
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Reviews Carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by thousands of Users worldwide"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Rating count",
      "default": "829"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer / product image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Sarah M."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Beautiful craftsmanship and calming energy. I wear it every day."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
