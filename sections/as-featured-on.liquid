{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* As Featured On — press logo strip, replicates buddhapowerstore layout.
     Uses footer brand variables so the dark band blends seamlessly with the
     scheme-3 footer below it. */
  .as-featured-on {
    background-color: var(--brand-footer-bg);
    color: var(--brand-footer-text);
    overflow: hidden;
  }

  .as-featured-on__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Override global h2 dark-text rule so the title stays light on dark bg */
  .as-featured-on__title {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--brand-footer-text);
    margin: 0 0 2.5rem;
  }

  .as-featured-on__logos {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    width: 100%;
    gap: {{ section.settings.logo_gap }}px;
  }

  .as-featured-on__logo {
    flex: 0 0 auto;
    padding: 0 0.5rem;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .as-featured-on__logo:hover {
    opacity: 1;
  }

  .as-featured-on__link {
    display: block;
    line-height: 0;
  }

  .as-featured-on__logo-img {
    display: block;
    margin: 0 auto;
    width: 100%;
    max-width: {{ section.settings.logo_max_width }}px;
    height: auto;
  }

  .as-featured-on__placeholder {
    background-color: rgba(245, 241, 234, 0.1);
  }

  @media screen and (max-width: 749px) {
    .as-featured-on__title {
      margin-bottom: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="as-featured-on color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="as-featured-on__wrapper page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="as-featured-on__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="as-featured-on__logos">
        {%- for block in section.blocks -%}
          <div class="as-featured-on__logo" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="as-featured-on__link">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {%- assign logo_alt = block.settings.logo_name -%}
              {%- if logo_alt == blank -%}
                {%- assign logo_alt = block.settings.image.alt -%}
              {%- endif -%}
              {%- if logo_alt == blank -%}
                {%- assign logo_alt = 'Featured in the press' -%}
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 360
                | image_tag:
                  widths: '180, 240, 360',
                  sizes: '(min-width: 750px) 180px, 140px',
                  class: 'as-featured-on__logo-img',
                  alt: logo_alt
              }}
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'as-featured-on__logo-img as-featured-on__placeholder' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "As Featured On",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "As Featured On:",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-3",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 180,
      "label": "Logo max width"
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Gap between logos"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_name",
          "label": "Logo name (alt text)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Featured On",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
