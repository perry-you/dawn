{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .faq-category__back {
    display: inline-block;
    margin-bottom: 1.6rem;
    text-decoration: none;
  }

  .faq-category__back:hover {
    text-decoration: underline;
  }

  /* FAQ answers are stored in the page body (page.content) so SEO tools can read them.
     Content is shown fully expanded in a single column. */
  .faq-category__content {
    margin-bottom: 0;
  }

  .faq-category__content h2,
  .faq-category__content h3 {
    margin-top: 3rem;
    margin-bottom: 0.8rem;
  }

  .faq-category__content h2:first-child,
  .faq-category__content h3:first-child {
    margin-top: 0;
  }

  .faq-category__content p {
    margin-top: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.back_link != blank -%}
      <a href="{{ section.settings.back_link }}" class="faq-category__back link">
        &larr; {{ section.settings.back_label | default: 'Back to FAQ' | escape }}
      </a>
    {%- endif -%}

    {%- liquid
      assign page_heading = page.title | default: section.settings.heading
    -%}
    {%- if page_heading != blank -%}
      <h1 class="faq-category__heading {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ page_heading | escape }}
      </h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    {%- comment -%}
      The FAQ questions and answers live in the page's rich-text body (page.content) so
      third-party SEO tools such as Avada can read and score the content. Paste the questions
      as headings with answers as paragraphs; everything is shown expanded in a single column.
    {%- endcomment -%}
    {%- if page.content != blank -%}
      <div class="faq-category__content rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ category",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Back link (to FAQ hub)"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Back to FAQ"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (fallback)",
      "info": "Used only if the page has no title. Normally the page title is shown.",
      "default": "Category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "FAQ category"
    }
  ]
}
{% endschema %}
