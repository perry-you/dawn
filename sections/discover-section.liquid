{% comment %}
  Discover What Moves You - Category Grid Section
  Placement: Homepage, between Hero and Bestsellers
  Customizable via Theme Editor schema
{% endcomment %}

<section class="discover-section{% if section.settings.full_width == false %} page-width{% endif %}">
  <div class="discover-header">
    {% if section.settings.heading != blank %}
      <h2 class="discover-title h1">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <div class="discover-subtitle">{{ section.settings.subheading }}</div>
    {% endif %}
  </div>

  <div class="discover-grid">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="discover-card discover-card--{{ forloop.index }}"
        {% if block.settings.link_type == 'external' %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        <div class="discover-card__img">
          {% if block.settings.image != blank %}
            {%- assign img_140 = block.settings.image | image_url: width: 140 -%}
            {%- assign img_100 = block.settings.image | image_url: width: 100 -%}
            {%- assign img_120 = block.settings.image | image_url: width: 120 -%}
            {%- assign img_240 = block.settings.image | image_url: width: 240 -%}
            <img
              src="{{ img_140 }}"
              srcset="{{ img_100 }} 100w, {{ img_120 }} 120w, {{ img_140 }} 140w, {{ img_240 }} 240w"
              sizes="(max-width: 600px) 100px, (max-width: 900px) 120px, 140px"
              alt="{{ block.settings.label | default: 'Category image' | escape }}"
              width="140"
              height="140"
              loading="lazy"
            >
          {% else %}
            <div class="discover-card__placeholder">
              {{ block.settings.label | default: 'Category' | slice: 0, 1 }}
            </div>
          {% endif %}
          {% if block.settings.badge_text != blank %}
            <span class="discover-card__badge">{{ block.settings.badge_text | escape }}</span>
          {% endif %}
        </div>
        {% if block.settings.label != blank %}
          <span class="discover-card__label">{{ block.settings.label | escape }}</span>
        {% endif %}
      </a>
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "Discover What Moves You",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (optional)",
          "info": "e.g. NEW, SALE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discover What Moves You",
      "blocks": [
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.discover-section {
  padding: 6.9rem 0 1rem;
  text-align: center;
}

.discover-header { margin-bottom: 3.6rem; }

.discover-title {
  font-size: 2.4rem;
  font-weight: 700;
  letter-spacing: -0.05rem;
  margin: 6.6rem 0 1rem;
  font-family: var(--font-heading-family);
}

.discover-subtitle {
  font-size: 1.8rem;
  color: rgba(var(--color-foreground), 0.6);
  max-width: 52rem;
  margin: 0 auto;
  line-height: 1.6;
}

.discover-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 2rem 1.6rem;
  max-width: 98rem;
  margin: 0 auto;
}

.discover-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
}

.discover-card:hover {
  transform: translateY(-0.4rem);
}

.discover-card:hover .discover-card__img {
  box-shadow: 0 0.4rem 2rem rgba(0, 0, 0, 0.12);
}

.discover-card:hover .discover-card__label {
  color: rgb(var(--color-link));
}

.discover-card__img {
  position: relative;
  width: 14rem;
  height: 14rem;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(var(--color-foreground), 0.04);
  box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.06);
  transition: box-shadow 0.3s ease;
  margin-bottom: 1rem;
}

.discover-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.discover-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  font-weight: 700;
  color: rgba(var(--color-foreground), 0.3);
}

.discover-card__badge {
  position: absolute;
  top: 0.4rem;
  right: 0.4rem;
  background: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  font-size: 0.6rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 99.9rem;
  letter-spacing: 0.05rem;
}

.discover-card__label {
  font-size: 2rem;
  font-weight: 500;
  transition: color 0.2s ease;
  line-height: 1.3;
}

/* Responsive breakpoints */
@media screen and (max-width: 899px) {
  .discover-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .discover-card__img {
    width: 12rem;
    height: 12rem;
  }
}

@media screen and (max-width: 599px) {
  .discover-section {
    padding: 3.2rem 1.2rem;
  }
  .discover-title {
    font-size: 1.8rem;
  }
  .discover-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem 0.8rem;
  }
  .discover-card__img {
    width: 10rem;
    height: 10rem;
  }
  .discover-card__label {
    font-size: 1.2rem;
  }
  .discover-subtitle {
    font-size: 0.8rem;
  }
}

@media screen and (max-width: 359px) {
  .discover-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (prefers-reduced-motion: reduce) {
  .discover-card { transition: none; }
  .discover-card__img { transition: none; }
  .discover-card__label { transition: none; }
}
{% endstylesheet %}
