{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .faq-hub__banner {
    margin: 0;
    line-height: 0;
  }

  .faq-hub__banner img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 35 / 9;
    object-fit: cover;
  }

  /* The entire hub body, including the category cards, is edited in the backend page
     rich-text editor (page.content) so third-party SEO tools such as Avada can read it.
     Paste card HTML using the classes below; the CSS styles them into a responsive grid. */

  .faq-hub__content .faq-hub__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .faq-hub__content .faq-hub__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.4rem;
    }
  }

  .faq-hub__content .faq-hub__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    height: 100%;
    padding: 3.2rem 2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--text-boxes-radius, 0);
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-hub__content .faq-hub__card:hover {
    border-color: rgba(var(--color-foreground), 0.3);
    transform: translateY(-0.4rem);
    box-shadow: 0 1rem 2rem rgba(var(--color-foreground), 0.08);
  }

  .faq-hub__content .faq-hub__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    margin: 0 auto 1.6rem;
  }

  .faq-hub__content .faq-hub__icon img,
  .faq-hub__content .faq-hub__icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: rgb(var(--color-foreground));
  }

  .faq-hub__content .faq-hub__card-title {
    margin: 0 0 0.8rem;
  }

  .faq-hub__content .faq-hub__card-count {
    margin: 0;
    opacity: 0.7;
    font-size: 1.4rem;
  }
{%- endstyle -%}

{%- if section.settings.banner_image != blank -%}
  <div class="faq-hub__banner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <img
      src="{{ section.settings.banner_image }}"
      alt="{{ section.settings.banner_alt | default: page.title | default: section.settings.heading | escape }}"
      width="{{ section.settings.banner_width | default: 1600 }}"
      height="{{ section.settings.banner_height | default: 411 }}"
      loading="eager"
    >
  </div>
{%- endif -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- liquid
      assign hub_heading = section.settings.heading
      if section.settings.use_page_title
        assign hub_heading = page.title | default: section.settings.heading
      endif
    -%}
    {%- if hub_heading != blank -%}
      <h1 class="faq-hub__heading {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ hub_heading | escape }}
      </h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    {%- comment -%}
      The whole hub body (intro copy + category cards) is authored in the backend page
      rich-text editor (page.content). Edit the cards there via the code (<>) view.
    {%- endcomment -%}
    {%- if page.content != blank -%}
      <div class="faq-hub__content rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ hub",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "text",
      "id": "banner_image",
      "label": "Banner image URL",
      "info": "Full image URL shown at the top of the page. Leave blank to hide.",
      "default": "https://cdn.shopify.com/s/files/1/0826/0799/7161/files/kailashway-faq-banner.png?v=1788226829"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Banner image alt text",
      "info": "Describe the image for accessibility and SEO."
    },
    {
      "type": "number",
      "id": "banner_width",
      "label": "Banner image width (px)",
      "info": "The image's actual pixel width. Used to reserve space and prevent layout shift."
    },
    {
      "type": "number",
      "id": "banner_height",
      "label": "Banner image height (px)",
      "info": "The image's actual pixel height. Keep the correct ratio to avoid distortion."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "use_page_title",
      "label": "Use page title as heading",
      "info": "Show the page's title instead of the heading above.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "FAQ hub"
    }
  ]
}
{% endschema %}
