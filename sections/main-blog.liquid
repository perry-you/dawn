{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ===== Blog homepage redesign (大地疗愈配色) ===== */

  /* Hero 标题区 */
  .blog-hero {
    text-align: center;
    padding: 6rem 0 3rem;
    background: linear-gradient(135deg, #F5F1ED 0%, var(--brand-bg-page, #F5F1EA) 100%);
    border-radius: 1.2rem;
    margin-bottom: 3.2rem;
  }
  .blog-hero h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-text-main, #2D2A26);
    margin-bottom: 1.2rem;
  }
  .blog-hero__sub {
    font-size: 1.5rem;
    color: #6B6460;
    max-width: 70ch;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* 标签筛选栏 */
  .blog-filter-bar {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 2rem 0;
    background: #F5F1ED;
    border-radius: 0.8rem;
    margin: 2.4rem 0;
  }
  .blog-filter-bar__tag {
    padding: 0.6rem 1.6rem;
    border-radius: 999px;
    font-size: 1.4rem;
    font-weight: 500;
    border: 1px solid var(--brand-border, #E8E2D5);
    background: #fff;
    color: var(--brand-text-main, #2D2A26);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .blog-filter-bar__tag:hover {
    border-color: var(--brand-primary, #B8956A);
    color: var(--brand-primary, #B8956A);
  }
  .blog-filter-bar__tag.is-active {
    background: var(--brand-primary, #B8956A);
    color: #fff;
    border-color: var(--brand-primary, #B8956A);
  }

  /* 文章卡片标签 chip — 小尺寸圆角 chip */
  .blog-tag-chip {
    display: inline-block;
    font-size: 1.1rem;
    padding: 0.15rem 0.8rem;
    border-radius: 999px;
    background: rgba(184, 149, 106, 0.12);
    color: var(--brand-primary, #B8956A);
    font-weight: 600;
    text-transform: capitalize;
    margin-left: 0.6rem;
    vertical-align: middle;
  }
  .article-card__info .blog-tag-chip::before { content: none; }

  /* 邮件订阅区 — 独立 Newsletter section 已由 Dawn 原生支持；这里用自定义轻量 fallback */
  .blog-newsletter-fallback {
    text-align: center;
    padding: 3.2rem 1.6rem;
    background: #F5F1ED;
    border-radius: 1.2rem;
    margin-top: 4rem;
  }
  .blog-newsletter-fallback h2 { font-size: 2.2rem; margin-bottom: 0.6rem; color: var(--brand-text-main, #2D2A26); }
  .blog-newsletter-fallback p { color: #6B6460; margin-bottom: 1.6rem; }
  .blog-newsletter-fallback form {
    display: flex; gap: 0.6rem; max-width: 48rem; margin: 0 auto;
  }
  .blog-newsletter-fallback input[type="email"] {
    flex: 1;
    padding: 1rem 1.4rem;
    border: 1px solid var(--brand-border, #E8E2D5);
    border-radius: 0.8rem;
    font-size: 1.4rem;
  }
  .blog-newsletter-fallback button {
    background: var(--brand-primary, #B8956A);
    color: #fff;
    border: none;
    border-radius: 0.8rem;
    padding: 1rem 2rem;
    font-weight: 600;
    font-size: 1.4rem;
    cursor: pointer;
  }
  .blog-newsletter-fallback button:hover { background: #A6845A; }

  /* 响应式 */
  @media screen and (max-width: 749px) {
    .blog-hero { padding: 4rem 0 2.4rem; }
    .blog-filter-bar { gap: 0.6rem; }
    .blog-filter-bar__tag { padding: 0.4rem 1rem; font-size: 1.2rem; }
    .blog-newsletter-fallback form { flex-direction: column; }
  }
{%- endstyle -%}

{%- paginate blog.articles by 8 -%}
  {%- assign current_tag = current_tag | default: nil -%}
  <div class="main-blog page-width section-{{ section.id }}-padding">
{% comment %}
  ===== 板块1: Hero 标题区（所有博客页都显示） =====
{% endcomment %}
    <div class="blog-hero">
      <h1 class="title--primary">{{ blog.title | escape }}</h1>
      {%- if current_tag == nil and paginate.current_offset == 0 -%}
        <p class="blog-hero__sub">Your guide to spiritual jewelry, crystal meanings, and sacred symbols from traditions around the world.</p>
      {%- elsif current_tag -%}
        <p class="blog-hero__sub">Browsing: {{ current_tag | replace: '-', ' ' | capitalize }}</p>
      {%- endif -%}
    </div>
{% comment %}
  ===== 板块2: 标签筛选栏（所有博客页都显示） =====
{% endcomment %}
    {%- capture blog_tags_raw -%}
      {%- for article in blog.articles -%}
        {%- for tag in article.tags -%}{{ tag }},{%- endfor -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign all_tags = blog_tags_raw | split: ',' | uniq | sort -%}
    {%- if all_tags.size > 0 -%}
      <div class="blog-filter-bar">
        <a href="/blogs/{{ blog.handle }}" class="blog-filter-bar__tag {% if current_tag == nil %}is-active{% endif %}">All</a>
        {%- for tag in all_tags -%}
          {%- unless tag == blank -%}
            <a href="/blogs/{{ blog.handle }}/tagged/{{ tag }}" class="blog-filter-bar__tag {% if current_tag == tag %}is-active{% endif %}">{{ tag | replace: '-', ' ' }}</a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
{% comment %}
  ===== 板块4: 文章列表 =====
{% endcomment %}
    <div class="blog-articles {% if section.settings.layout == 'collage' %}blog-articles--collage{% endif %}">
      {%- for article in blog.articles -%}
        <div
          class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- render 'article-card',
            article: article,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true
          -%}
        </div>
      {%- endfor -%}
    </div>
{% comment %}
  ===== 分页 =====
{% endcomment %}
    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}

  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main-blog.settings.layout.options__1.label"
        },
        {
          "value": "collage",
          "label": "t:sections.main-blog.settings.layout.options__2.label"
        }
      ],
      "default": "grid",
      "label": "t:sections.main-blog.settings.layout.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
